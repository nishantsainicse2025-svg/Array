#include <stdio.h>

int main() {
    int arr[100] = {10, 20, 30, 40, 50};
    int n = 5;
    int i, pos, value;

    // -------- TRAVERSAL --------
    printf("Original Array: ");
    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    // -------- INSERTION --------
    pos = 2;
    value = 25;

    for (i = n; i > pos; i--) {
        arr[i] = arr[i - 1];
    }

    arr[pos] = value;
    n++;

    printf("\nAfter Insertion: ");
    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    // -------- DELETION --------
    pos = 3;

    for (i = pos; i < n - 1; i++) {
        arr[i] = arr[i + 1];
    }

    n--;

    printf("\nAfter Deletion: ");
    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}
